{
  "name": "planly",
  "version": "2.0.0",
  "private": true,
  "description": "Planly — a Trello-style Kanban board (Electron + node:sqlite + React + MCP)",
  "author": "zefang",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "build:mcp": "tsc -p tsconfig.mcp.json",
    "mcp": "node dist-mcp/mcp/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.web.json",
    "package": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "build": {
    "appId": "com.planly.app",
    "productName": "Planly",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/migrations",
        "to": "migrations"
      }
    ],
    "mac": {
      "target": "dmg",
      "identity": null,
      "category": "public.app-category.productivity"
    }
  },
  "devDependencies": {
    "@hello-pangea/dnd": "^18.0.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "drizzle-kit": "^1.0.0-rc.4",
    "drizzle-orm": "^1.0.0-rc.4",
    "electron": "^37.10.3",
    "electron-builder": "^26.15.3",
    "electron-vite": "^2.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "zod": "^4.6.5"
  }
}
